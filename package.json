{
  "name": "pi-loop",
  "version": "0.1.0",
  "description": "Pi 扩展：激活后无限自我迭代",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerryshell/pi-loop.git"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
